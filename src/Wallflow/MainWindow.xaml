<Window x:Class="Wallflow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="Pane">
 <Grid x:Name="RootGrid" Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Padding="28,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"><Image Width="30" Height="30" Source="ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-32.png" Stretch="Uniform"/><TextBlock Text="Pane" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><Grid><Grid MaxWidth="1080" MinWidth="860" Padding="24,10,24,12" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Button x:Name="SetupSwitcherButton" Style="{StaticResource SetupHeaderButtonStyle}" AutomationProperties.Name="Open setups" Click="SetupSwitcherButton_Click">
      <StackPanel Orientation="Horizontal" Spacing="9">
       <TextBlock x:Name="ActiveSetupName" Text="My Setup" FontSize="28" FontWeight="SemiBold" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
       <FontIcon Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <TextBlock x:Name="SetupSummary" Text="Finding your displays…" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Identify displays" Click="Identify_Click"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" Margin="0,12,0,10" Padding="14" Height="210" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"><Canvas x:Name="MonitorCanvas" Height="181" SizeChanged="Canvas_SizeChanged"/></Border>
   <Border Grid.Row="2" Padding="18" Height="360" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Button x:Name="MonitorNameButton" Style="{StaticResource SetupHeaderButtonStyle}" Padding="0" Click="MonitorNameButton_Click" HorizontalAlignment="Left" AutomationProperties.Name="Rename selected monitor"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="SelectedName" Text="Select a display" FontSize="22" FontWeight="SemiBold"/><SymbolIcon Symbol="Edit" Opacity="0.48"/></StackPanel></Button><TextBox x:Name="MonitorNameEditor" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="180" MaxWidth="420" MaxLength="48" Style="{StaticResource JellyTextBoxStyle}" KeyDown="MonitorNameEditor_KeyDown" LostFocus="MonitorNameEditor_LostFocus"/></Grid><TextBlock Grid.Row="1" x:Name="SelectedDetails" MinHeight="20" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,12"/><Border Grid.Row="2" MinHeight="155" CornerRadius="14" Background="#FF090A0D"><Grid><Image x:Name="WallpaperPreview" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xEB9F;" FontSize="28" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="Choose a wallpaper" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Grid></Border></Grid>
     <Grid Grid.Column="2" x:Name="Editor" IsHitTestVisible="False" Opacity="0.55"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ToggleSwitch x:Name="ModeToggle" OffContent="Static" OnContent="Slideshow" Toggled="ModeToggle_Toggled" Margin="0,0,0,22"/>
      <Grid Grid.Row="1"><StackPanel x:Name="StaticPanel" Spacing="10"><TextBlock Text="Wallpaper image" FontWeight="SemiBold"/><Button Content="Choose image" Click="ChooseImage_Click" HorizontalAlignment="Stretch"/><TextBlock x:Name="ImagePathText" Text="No image selected" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
       <StackPanel x:Name="SlideshowPanel" Visibility="Collapsed" Spacing="10"><TextBlock Text="Slideshow folder" FontWeight="SemiBold"/><Button Content="Choose folder" Click="ChooseFolder_Click" HorizontalAlignment="Stretch"/><TextBlock x:Name="FolderPathText" Text="No folder selected" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Every"/><ComboBox x:Name="IntervalBox" SelectedIndex="2" SelectionChanged="EditorSelection_Changed" Margin="0,6,8,0"><ComboBoxItem Content="1 minute" Tag="1"/><ComboBoxItem Content="2 minutes" Tag="2"/><ComboBoxItem Content="5 minutes" Tag="5"/><ComboBoxItem Content="30 minutes" Tag="30"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Transition"/><ComboBox x:Name="TransitionBox" SelectedIndex="1" SelectionChanged="EditorSelection_Changed" Margin="8,6,0,0"><ComboBoxItem Content="None"/><ComboBoxItem Content="Soft fade"/></ComboBox></StackPanel></Grid><StackPanel Orientation="Horizontal" Spacing="28"><ToggleSwitch x:Name="ShuffleToggle" Header="Shuffle" IsOn="True" Toggled="EditorToggle_Toggled"/><ToggleSwitch x:Name="LoopToggle" Header="Loop" IsOn="True" Toggled="EditorToggle_Toggled"/></StackPanel></StackPanel></Grid>
      <TextBlock Grid.Row="2" x:Name="ValidationText" Foreground="#FFFF7B86" Margin="0,8,0,8" TextWrapping="Wrap"/>
      <Grid Grid.Row="3"><ComboBox x:Name="FitBox" SelectedIndex="0" SelectionChanged="FitBox_SelectionChanged" HorizontalAlignment="Left"><ComboBoxItem Content="Fill"/><ComboBoxItem Content="Fit"/><ComboBoxItem Content="Stretch"/><ComboBoxItem Content="Center"/></ComboBox><Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" HorizontalAlignment="Right" Style="{StaticResource JellyAccentButtonStyle}" Padding="28,10"/></Grid>
     </Grid></Grid></Border>
   </Grid></Grid></ScrollViewer>
  <Grid x:Name="SetupPanelDismissLayer" Grid.RowSpan="2" Background="#01000000" Visibility="Collapsed" Canvas.ZIndex="25" PointerPressed="SetupPanelDismissLayer_PointerPressed"/>
  <Grid x:Name="SetupPanel" Grid.RowSpan="2" Width="420" MaxHeight="560" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Canvas.ZIndex="30">
   <Grid x:Name="SetupPanelShadowHost" IsHitTestVisible="False"/>
   <Border x:Name="SetupPanelSurface" CornerRadius="20" Background="#FF191C23" BorderBrush="#1AFFFFFF" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="SetupPanelDragHeader" MinHeight="54" HorizontalAlignment="Stretch" Background="#01000000" Padding="18,12" PointerPressed="SetupPanelDragHeader_PointerPressed" PointerMoved="SetupPanelDragHeader_PointerMoved" PointerReleased="SetupPanelDragHeader_PointerReleased" PointerCanceled="SetupPanelDragHeader_PointerCanceled" PointerCaptureLost="SetupPanelDragHeader_PointerCaptureLost"><TextBlock Text="Setups" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
     <ScrollViewer Grid.Row="1" Margin="14,0" MaxHeight="430" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SetupCardsPanel" Spacing="10"/></ScrollViewer>
     <Button Grid.Row="2" Click="NewSetup_Click" Margin="14,10,14,14" HorizontalAlignment="Stretch" AutomationProperties.Name="Create a new setup"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock Text="New Setup"/></StackPanel></Button>
    </Grid>
   </Border>
  </Grid>
  <Border x:Name="SetupStatusSurface" Grid.RowSpan="2" Style="{StaticResource FloatingStatusStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" Opacity="0" Visibility="Collapsed" Canvas.ZIndex="20">
   <Border.RenderTransform><CompositeTransform x:Name="SetupStatusTransform" TranslateY="8"/></Border.RenderTransform>
   <StackPanel Orientation="Horizontal" Spacing="14"><TextBlock x:Name="SetupStatusText" VerticalAlignment="Center" FontWeight="SemiBold"/><Button x:Name="SetupUndoButton" Content="Undo" Click="SetupUndo_Click" Style="{StaticResource SetupStatusActionButtonStyle}"/></StackPanel>
  </Border>
 </Grid>
</Window>
